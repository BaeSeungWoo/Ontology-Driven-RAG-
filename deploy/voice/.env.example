# Copy to .env and replace these placeholders. Do not commit .env.
STT_MODEL=turbo
VOICE_DOMAIN=voice.example.com
VOICE_FRONTEND=127.0.0.1:3000
VOICE_BACKEND=127.0.0.1:8000
VOICE_BASIC_USER=voice
# Paste output of caddy hash-password, keeping single quotes around the hash.
VOICE_BASIC_HASH=''
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Same value in the backend environment; NEVER put in NEXT_PUBLIC variables.
VOICE_GATEWAY_KEY=

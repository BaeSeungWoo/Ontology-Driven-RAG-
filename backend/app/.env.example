# SQL Server 접속 주소
MSSQL_HOST=

# SQL Server 접속 포트
MSSQL_PORT=

# SQL Server 로그인 계정
MSSQL_USERNAME=

# SQL Server 로그인 비밀번호
MSSQL_PASSWORD=

# 기본 연결 풀의 데이터베이스
MSSQL_DATABASE=

# secondary 연결 풀의 데이터베이스
MSSQL_SECONDARY_DATABASE=

# third 연결 풀의 데이터베이스
MSSQL_THIRD_DATABASE=

# forth 연결 풀의 데이터베이스
MSSQL_FORTH_DATABASE=

# 기존 시크릿 설정 (현재 저장소에서 직접 참조 없음)
SECRET_KEY=

# 기존 JWT 시크릿 설정 (현재 저장소에서 직접 참조 없음)
JWT_SECRET_KEY=

# 백엔드 음성 기능 활성화
VOICE_ENABLED=

# 음성 요청을 허용할 출처
VOICE_ALLOWED_ORIGINS=

# 음성을 문자로 변환하는 서버 주소
VOICE_STT_URL=

# MES·CMS 일일 보고서 DB 조회·저장에 사용하는 단일 공장 식별값
REPORT_FACTORY_ID=

# 선택 사항: 연암(구) M005 전용 제어기 인덱스를 기본 위치 이외에 배치할 때
# GRAPH_INDEX_M005_CONTROLLER_DIR=

# 연암(구)에 graph/catalog.json이 없고 M005 이외 장비에서 구형 검색을 사용할 때만
# dhf8000 및 fanuc 인덱스의 기본 경로를 각각 재지정할 수 있습니다.
# GRAPH_INDEX_DHF8000_DIR=
# GRAPH_INDEX_FANUC_DIR=

# 메인 서버에서 온 요청인지 판별할 주소
MAIN_SERVER_URL=

# 화면과 검색에서 사용할 공장 폴더명. 쉼표 순서대로 표시하며 한 개면 자동 선택
FACTORY_IDS=yunam_origin,yunam,yulkok,poongsan,waff,3way
